# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TMDB_API_KEY: Requis pour interroger la base de données mondiale des films (The Movie Database).
# Vous pouvez obtenir cette clé gratuitement sur TheMovieDB.org.
TMDB_API_KEY="votre_cle_tmdb"

# Code secret à partager à vos proches pour qu'ils puissent s'inscrire
INVITE_CODE="DELOREAN"
