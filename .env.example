# Variables de sécurité obligatoires
# JWT_SECRET: Clé secrète utilisée pour chiffrer les sessions de connexion.
# Utilisez une chaîne longue et imprévisible. Ne la modifiez plus une fois en production.
JWT_SECRET="votre_jwt_secret_ici"

# TMDB_API_KEY: Requis pour interroger la base de données mondiale des films (The Movie Database).
# Vous pouvez obtenir cette clé gratuitement sur TheMovieDB.org.
TMDB_API_KEY="749cc423a9ddf480d6c036f7a51d7486"

# Configuration Jellyfin
JELLYFIN_URL="https://jellyfin.rpisimon.uk"
JELLYFIN_API_KEY="31104b816e714d128b70dd5c3fe35abc"

# Configuration SMTP (Optionnel et recommandé en production pour la validation par e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="CinéPrivé Sécurité"
SMTP_FROM_EMAIL="security@cineprive.rpisimon.uk"

# Code de sécurité Maître de secours (Optionnel).
# Si défini, ce code permet au Patron de valider directement n'importe quelle suppression définitive
# sans avoir besoin d'envoyer un e-mail ou d'avoir configuré de serveur SMTP.
SECURITY_MASTER_CODE=
